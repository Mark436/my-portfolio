---
import { Image } from "astro:assets";
import PreviewDefault from "@/assets/proyectos/default.svg";
import StatusBadge from "@/components/StatusBadge.astro";
import type { Project } from "@/data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { tag, title, desc, image, chips, github, preview, status, progress } =
  project;
---

<article class="flex flex-col md:flex-row gap-8 lg:gap-12 fade-up-entry">
  <div
    class="w-full md:w-5/12 lg:w-1/2 rounded-2xl overflow-hidden border border-divider shadow-sm bg-surface aspect-[8/5] md:aspect-auto"
  >
    {
      image ? (
        <Image
          src={image}
          alt={`Captura del proyecto ${title}`}
          class="media-shot w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <PreviewDefault class="w-full h-full hover:scale-105 transition-transform duration-500" />
      )
    }
  </div>

  <div class="w-full md:w-7/12 lg:w-1/2 flex flex-col justify-center">
    <div class="flex flex-wrap items-center gap-3 mb-2">
      <span class="font-mono text-sm text-muted">{tag}</span>
      <StatusBadge status={status} progress={progress} />
    </div>

    <h3 class="text-2xl md:text-3xl font-bold mb-4 text-main tracking-tight">
      {title}
    </h3>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        chips.map((chip) => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium border border-divider bg-surface text-main shadow-sm">
            {chip}
          </span>
        ))
      }
    </div>

    <p class="text-muted text-base md:text-lg mb-8 leading-relaxed">{desc}</p>

    <div class="flex flex-wrap gap-3 mt-auto">
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-sans text-sm font-medium transition-all duration-200 border shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:shadow-sm bg-surface text-main border-divider hover:bg-bg"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4" />
            </svg>
            Code
          </a>
        )
      }
      {
        preview && (
          <a
            href={preview}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-sans text-sm font-medium transition-all duration-200 border shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:shadow-sm bg-surface text-main border-divider hover:bg-bg"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Preview
          </a>
        )
      }
    </div>
  </div>
</article>
