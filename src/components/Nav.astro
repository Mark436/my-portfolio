---
import { NAV_ITEMS } from "@/data/site";
---

<nav
  id="site-nav"
  class="at-top fixed inset-x-0 top-0 z-50 flex justify-center"
>
  <div
    id="nav-bar"
    class="flex items-center justify-center bg-surface/80 backdrop-blur-xl"
  >
    <ul
      class="flex items-center gap-1 px-2 list-none m-0 p-0 text-center"
      id="nav-list"
    >
      <span
        class="bg-bg/35 border border-divider shadow-sm pointer-events-none"
        id="hover-indicator"></span>
      <span
        class="bg-bg/35 border border-divider shadow-sm pointer-events-none"
        id="indicator"></span>
      {
        NAV_ITEMS.map((item) => (
          <li class="flex items-center">
            <a
              href={item.href}
              class="px-4 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 text-nowrap"
            >
              {item.content}
            </a>
          </li>
        ))
      }

      <li>
        <div class="flex items-center">
          <span class="w-px h-5 bg-divider mx-2 pointer-events-none"></span>
          <button
            id="theme-btn"
            type="button"
            aria-label="Cambiar tema"
            class="p-2 rounded-full hover:bg-bg transition-colors text-muted hover:text-main"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </button>
        </div>
      </li>
    </ul>
  </div>
</nav>

<script>
  const themeBtn = document.getElementById("theme-btn");
  themeBtn?.addEventListener("click", () => {
    const el = document.documentElement;
    const isDark = el.classList.toggle("dark");

    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
<script>
  const nav = document.getElementById("site-nav");
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#nav-list a"),
  );

  const sections = navLinks
    .map((a) => document.querySelector(a.getAttribute("href") ?? ""))
    .filter((el) => el !== null);

  const clearActive = () =>
    navLinks.forEach((a) => a.classList.remove("active"));

  const setActive = (id) => {
    clearActive();
    navLinks
      .find((a) => a.getAttribute("href") === `#${id}`)
      ?.classList.add("active");
  };

  let isManualNav = false;
  let manualNavTimeout;

  const endManualNav = () => {
    isManualNav = false;
    clearTimeout(manualNavTimeout);
    window.removeEventListener("scroll", onManualNavScroll);
    window.removeEventListener("scrollend", endManualNav);
  };

  // El modo manual dura hasta que el scroll se detiene. Se apoya en
  // scrollend y, como respaldo, en un timeout que se reinicia con cada
  // scroll (o se dispara si no hubo ninguno). Así el observer retoma el
  // control sin saltarse el scroll en curso.
  const onManualNavScroll = () => {
    clearTimeout(manualNavTimeout);
    manualNavTimeout = setTimeout(endManualNav, 500);
  };

  // Banda central del viewport donde una sección se considera visible.
  // Debe coincidir con el rootMargin del observer (-45% arriba y abajo).
  const BAND_TOP = 0.55;
  const BAND_BOTTOM = 0.45;

  const sectionInBand = () =>
    sections.find((section) => {
      const rect = section.getBoundingClientRect();
      return (
        rect.top < window.innerHeight * BAND_TOP &&
        rect.bottom > window.innerHeight * BAND_BOTTOM
      );
    });

  const observer = new IntersectionObserver(
    () => {
      if (isManualNav) return;

      const current = sectionInBand();
      if (current) setActive(current.id);
      else clearActive();
    },
    { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
  );
  sections.forEach((section) => observer.observe(section));

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.getAttribute("href")?.replace("#", "");
      if (!id) return;

      isManualNav = true;
      setActive(id);

      window.removeEventListener("scroll", onManualNavScroll);
      window.addEventListener("scroll", onManualNavScroll, {
        passive: true,
      });
      window.removeEventListener("scrollend", endManualNav);
      window.addEventListener("scrollend", endManualNav);
      onManualNavScroll();
    });
  });

  const lastSection = sections[sections.length - 1];

  const HEADER_COLLAPSE_AT = 64;
  // Duración del morph, leída de --nav-morph para no duplicar el valor.
  const _morph = nav
    ? getComputedStyle(nav).getPropertyValue("--nav-morph")
    : "";
  const NAV_MORPH_MS =
    _morph.includes("s") && !_morph.includes("ms")
      ? Number.parseFloat(_morph) * 1000
      : Number.parseFloat(_morph) || 500;

  let headerExpanded = null;
  let settleTimeout;

  const setHeaderExpanded = (expanded) => {
    if (expanded === headerExpanded) return;
    headerExpanded = expanded;

    nav?.classList.toggle("at-top", expanded);
    clearTimeout(settleTimeout);

    if (expanded) {
      // Vuelve al header full-width: el selector se oculta y se
      // deshabilitan sus transiciones de geometría.
      nav?.classList.remove("nav-settled");
    } else {
      // Al convertirse en pill, el selector se habilita recién cuando el
      // morph terminó, para que aparezca ya colocado (sin deslizarse).
      settleTimeout = setTimeout(() => {
        nav?.classList.add("nav-settled");
      }, NAV_MORPH_MS);
    }
  };

  const handleTopState = () => {
    if (isManualNav) return;

    setHeaderExpanded(window.scrollY <= HEADER_COLLAPSE_AT);

    if (headerExpanded) clearActive();

    const scrolledToBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;

    if (scrolledToBottom && lastSection) setActive(lastSection.id);
  };

  handleTopState();
  window.addEventListener("scroll", handleTopState, { passive: true });
</script>

<style>
  /* ---------- Header: full-width arriba → pill al scrollear ---------- */
  #site-nav {
    --nav-morph: 400ms;
    --nav-pad: 0.75rem; /* p-3 (header full-width) */
    --nav-pill-pad: 0.375rem; /* p-1.5 (pill) */
    /* padding físico: Safari no interpola bien los shorthands lógicos */
    padding-top: 0;
    padding-bottom: 0;
    transition:
      padding-top var(--nav-morph) cubic-bezier(0.4, 0, 0.2, 1),
      padding-bottom var(--nav-morph) cubic-bezier(0.4, 0, 0.2, 1);
  }

  #site-nav:not(.at-top) {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  /* El ancho full-width ↔ pill se anima con flex-grow (número → número),
     porque Safari no interpola bien max-width entre % y px. */
  #nav-bar {
    flex-grow: 1;
    padding: var(--nav-pad);
    border-width: 1px;
    border-style: solid;
    border-color: transparent;
    border-bottom-color: var(--color-divider);
    border-radius: 0;
    box-shadow: 0 0 0 0 transparent;
    transition:
      flex-grow var(--nav-morph) cubic-bezier(0.4, 0, 0.2, 1),
      padding var(--nav-morph) cubic-bezier(0.4, 0, 0.2, 1),
      border-radius var(--nav-morph) cubic-bezier(0.4, 0, 0.2, 1),
      border-color 400ms ease,
      box-shadow 400ms ease,
      background-color 300ms ease;
  }

  #site-nav:not(.at-top) #nav-bar {
    flex-grow: 0;
    padding: var(--nav-pill-pad);
    border-color: var(--color-divider);
    border-radius: 999px;
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.18);
  }

  #nav-list a.active {
    anchor-name: --active;
    transition: color 300ms ease;
    color: var(--color-accent);
  }

  /* El hover se limita a dispositivos con capacidad de hover (mismo criterio
     que usan los `hover:` de Tailwind). En táctil el :hover queda "pegado"
     tras el tap y el resaltado no desaparece hasta tocar otro elemento. */
  @media (hover: hover) {
    #nav-list a:not(.active):hover {
      anchor-name: --hover;
      color: var(--color-accent);
      transition: color 400ms ease;
    }

    #nav-list:has(a:not(.active):hover) #hover-indicator {
      opacity: 1;
    }
  }

  /* Sin sección activa el selector se oculta de inmediato y sin transición de
     geometría: así, al aparecer, se coloca en su sitio sin deslizarse. */
  #nav-list:not(:has(a.active)) #indicator {
    opacity: 0;
    transition: none;
  }

  #indicator {
    opacity: 0;
    transition: opacity 200ms ease;

    position: absolute;
    position-anchor: --active;
    left: calc(anchor(left) - 4px);
    top: calc(anchor(top) - 4px);

    width: calc(anchor-size(width) + 8px);
    height: calc(anchor-size(height) + 8px);

    border-radius: 999px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18),
      rgba(255, 255, 255, 0.05)
    );

    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    padding: 4px;
  }

  /* El selector de sección (y sus transiciones de geometría) se habilita recién
     cuando el header terminó de convertirse en pill. */
  #site-nav.nav-settled #indicator {
    transition:
      left var(--nav-morph) ease,
      top var(--nav-morph) ease,
      width var(--nav-morph) ease,
      height var(--nav-morph) ease,
      opacity 200ms ease;
  }

  #site-nav.nav-settled #nav-list:has(a.active) #indicator {
    opacity: 1;
  }

  #hover-indicator {
    transition:
      left 400ms ease,
      top 400ms ease,
      width 400ms ease,
      height 400ms ease,
      opacity 200ms ease;

    position: absolute;
    position-anchor: --hover;
    left: calc(anchor(left) - 4px);
    top: calc(anchor(top) - 4px);

    width: calc(anchor-size(width) + 8px);
    height: calc(anchor-size(height) + 8px);

    border-radius: 999px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18),
      rgba(255, 255, 255, 0.05)
    );
    border: 1px solid rgba(255, 255, 255, 0.048);
    opacity: 0;
  }

  /* ---------- Modo oscuro: el acento verde brilla en el texto ---------- */
  :global(.dark) #nav-list a.active {
    text-shadow: 0 0 14px
      color-mix(in oklab, var(--color-accent) 55%, transparent);
  }
</style>
