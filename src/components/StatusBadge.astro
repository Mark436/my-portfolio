---
project: any
---
{#if project.status === "wip"}
<div class="flex items-center gap-1.5 mt-2">
  <span
    class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs font-medium text-amber-400"
  >
    En desarrollo ·
    {project.progress ?? 0}%
  </span>
  <div
    class="w-24 h-1.5 rounded-full bg-amber-500/10 overflow-hidden mt-0.5"
  >
    <div
      class="h-full bg-amber-500 rounded-full"
      style={project.progress ? `width:${project.progress}%` : "0%"}
    ></div>
  </div>
</div>
{/if}